<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Plantilla de sondeo mensual (ADR-008, decisión 8): día 1 de cada
  mes, 07:00. AJUSTAR las rutas al usuario real de la Mac mini antes
  de instalar (ver docs/sondeo-launchd.md). Frecuencia contenida
  según D6: mensual, sólo lectura, sin re-publicación.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>mx.imss.infosalud.sondeo</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/infosalud/infosalud/scripts/sondeo.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Day</key><integer>1</integer>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/infosalud/infosalud/data/sondeo-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/infosalud/infosalud/data/sondeo-launchd.log</string>
</dict>
</plist>
